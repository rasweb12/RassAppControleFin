<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData">
            <NotAuthorized><main><a href="/login" data-enhance-nav="false">Entrar</a></main></NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound><main><h1>Pagina nao encontrada</h1><a href="/">Voltar</a></main></NotFound>
</Router>
