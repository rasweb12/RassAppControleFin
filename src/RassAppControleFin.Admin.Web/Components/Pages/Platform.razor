@page "/platform"
@attribute [Authorize]
@inject PlatformClient Client
@implements IDisposable

<PageTitle>Administração da plataforma</PageTitle>
<header>
    <strong>RASS Administração</strong>
    <span><a href="/">Status</a></span>
    <form action="/auth/logout" method="post" data-enhance="false"><AntiforgeryToken /><button type="submit">Sair</button></form>
</header>
<main>
    <div class="heading">
        <h1>Administração da plataforma</h1>
        <button @onclick="RefreshAsync" disabled="@_loading" aria-label="Atualizar painel">↻</button>
    </div>
    <section aria-live="polite" aria-busy="@_loading">
        @if (_loading)
        {
            <p>Consultando permissões e indicadores...</p>
        }
        else if (_forbidden)
        {
            <p role="alert">Você não possui permissão de SuperAdmin para acessar este painel.</p>
        }
        else if (_dashboard is not null)
        {
            <dl>
                <div><dt>Usuários</dt><dd>@_dashboard.Users</dd></div>
                <div><dt>Tenants</dt><dd>@_dashboard.Tenants</dd></div>
                <div><dt>SuperAdmins ativos</dt><dd>@_dashboard.SuperAdmins</dd></div>
            </dl>
            <p class="notice">Funções de consulta e alteração de papéis permanecem protegidas pela API. Esta tela não exibe dados financeiros privados.</p>
        }
        else
        {
            <p role="alert">Não foi possível carregar o painel administrativo. Tente novamente.</p>
        }
    </section>
</main>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private PlatformDashboardDto? _dashboard;
    private bool _loading;
    private bool _forbidden;

    protected override Task OnInitializedAsync() => RefreshAsync();

    private async Task RefreshAsync()
    {
        if (_loading) return;
        _loading = true;
        _forbidden = false;
        try
        {
            _dashboard = await Client.GetDashboardAsync(_lifetime.Token);
            _forbidden = _dashboard is null;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        finally { _loading = false; }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
