@page "/login"
@attribute [ExcludeFromInteractiveRouting]
<PageTitle>Entrar | RASS Controle Financeiro</PageTitle>
<header><strong>RASS Controle Financeiro</strong></header>
<main class="login">
    <h1>Entrar</h1>
    @if (Error is not null) { <p role="alert">Nao foi possivel entrar. Verifique seus dados e tente novamente.</p> }
    <form method="post" action="/auth/session" data-enhance="false">
        <AntiforgeryToken />
        <label>E-mail<input name="email" type="email" autocomplete="username" required maxlength="254" /></label>
        <label>Senha<input name="password" type="password" autocomplete="current-password" required maxlength="128" /></label>
        <button type="submit">Entrar</button>
    </form>
    <details><summary>Criar conta</summary>
        <form method="post" action="/auth/session" data-enhance="false">
            <AntiforgeryToken /><input type="hidden" name="mode" value="signup" />
            <label>Nome<input name="name" autocomplete="name" required maxlength="120" /></label>
            <label>E-mail<input name="email" type="email" autocomplete="username" required maxlength="254" /></label>
            <label>Senha<input name="password" type="password" autocomplete="new-password" required minlength="12" maxlength="128" /></label>
            <button type="submit">Criar conta</button>
        </form>
    </details>
</main>
@code { [SupplyParameterFromQuery] public string? Error { get; set; } }
