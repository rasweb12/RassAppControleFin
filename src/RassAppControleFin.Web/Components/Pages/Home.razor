@page "/status"
@inject SystemClient Client
@implements IDisposable

<PageTitle>RASS Controle Financeiro</PageTitle>
<header><strong>RASS Controle Financeiro</strong><span>1.0.0-alpha.1</span></header>
<main>
    <div class="heading">
        <h1>Status do sistema</h1>
        <button @onclick="RefreshAsync" disabled="@_loading" aria-label="Atualizar status" title="Atualizar status"><img src="icons/refresh.svg" width="20" height="20" alt="" /></button>
    </div>
    <section aria-live="polite" aria-busy="@_loading">
        @if (_loading)
        {
            <p>Consultando API...</p>
        }
        else if (_error)
        {
            <p role="alert">API indisponivel. Tente atualizar.</p>
        }
        else if (_status is not null)
        {
            <dl>
                <div><dt>API</dt><dd class="online">Disponivel</dd></div>
                <div><dt>Produto</dt><dd>@_status.Name</dd></div>
                <div><dt>Versao</dt><dd>@_status.Version</dd></div>
                <div><dt>Etapa</dt><dd>@_status.Stage</dd></div>
            </dl>
        }
    </section>
</main>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private SystemStatusDto? _status;
    private bool _loading;
    private bool _error;

    protected override Task OnInitializedAsync() => RefreshAsync();

    private async Task RefreshAsync()
    {
        if (_loading) return;
        _loading = true;
        _error = false;
        try
        {
            _status = await Client.GetStatusAsync(_lifetime.Token);
            _error = _status is null;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (HttpRequestException) { _error = true; }
        catch (OperationCanceledException) { _error = true; }
        catch (Polly.Timeout.TimeoutRejectedException) { _error = true; }
        catch (Polly.CircuitBreaker.BrokenCircuitException) { _error = true; }
        catch (System.Text.Json.JsonException) { _error = true; }
        finally { _loading = false; }
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }
}
