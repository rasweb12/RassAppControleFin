# Reference only: .NET does not automatically load dotenv.
# Use dotnet user-secrets or environment variables. Never commit real values.
ASPNETCORE_ENVIRONMENT=Development
PORT=5080
Database__ConnectionString=
Database__RuntimeRole=rass_app_runtime
Database__MaxPoolSize=10
Database__ConnectionTimeoutSeconds=10
Database__CommandTimeoutSeconds=30
# Server-only DIRECT connection. Never set in Admin, Mobile, browser or Git.
RASS_MIGRATIONS_CONNECTION=
# Dedicated test database only: rass_sprint1_tests. Tests never skip without credentials.
RASS_DB_TEST_ADMIN=
RASS_DB_TEST_RUNTIME=
Neon__ProjectId=
Neon__BranchId=
Neon__AuthBaseUrl=
Neon__JwksUrl=
Neon__ExpectedIssuer=
Neon__ExpectedAudience=
Resend__ApiKey=
Resend__FromAddress=
Resend__WebhookSecret=
# Backend only. AI is disabled until the Sprint 8 gate.
GEMINI_API_KEY=
Gemini__Enabled=false
Gemini__Model=
Gemini__TimeoutSeconds=30
Gemini__MaxOutputTokens=2048
Gemini__Temperature=0.3
OTEL_EXPORTER_OTLP_ENDPOINT=
Api__BaseUrl=http://localhost:5080
AllowedHosts=localhost
